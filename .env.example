# Salin menjadi .env.local lalu isi. "npm run offline" menulis .env.local sendiri
# untuk Supabase lokal; isi manual hanya bila tidak memakai perintah itu.

# Isi "summary" hanya di Vercel: web menampilkan ringkasan dari "npm run web:publish"
# dan menyembunyikan tabel, upload, dan edit. Kosongkan untuk aplikasi offline.
NEXT_PUBLIC_DATA_MODE=

# Supabase (lokal: http://127.0.0.1:54321, kunci dari "npx supabase status -o env").
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Hanya untuk server dan scripts/ (akun, impor, hapus perusahaan).
# Rahasia: jangan beri awalan NEXT_PUBLIC_ dan jangan dimasukkan ke Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Kontak admin untuk "Hubungi admin" di halaman masuk: nomor WhatsApp (08…),
# email, atau tautan. Kosong: teks biasa tanpa tautan.
NEXT_PUBLIC_KONTAK_ADMIN=
